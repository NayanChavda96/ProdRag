    "# ─────────────────────────────────────────────────────────────\n",
    "# ACTION 2: Urgency Detector\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "@action(is_system_action=True)\n",
    "async def classify_urgency(context: Optional[dict] = None):\n",
