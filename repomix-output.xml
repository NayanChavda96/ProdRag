st.title("🧪 Enterprise RAG — Evaluation Suite")
st.caption("Step 1: Review ground truth → Step 2: Run live pipeline → Step 3: Score with RAGAS")
st.divider()

# ─────────────────────────────────────────────────────────────────────────────
# Tabs
