    )

    rag_rows = []
    for s in golden["rag_samples"]:
        rag_rows.append(
            {
                "ID": s["id"],
                "Domain": s["domain"].replace("_", " ").title(),
                "Question": s["question"],
                "Reference Answer": s["reference"][:120] + "..." if len(s["reference"]) > 120 else s["reference"],
