    -e "s|<JINA_API_KEY_ARN>|$JINA_API_KEY_ARN|g" \
    -e "s|<PORTKEY_API_KEY_ARN>|$PORTKEY_API_KEY_ARN|g" \
    -e "s|<RAG_API_KEY_ARN>|$RAG_API_KEY_ARN|g" \
